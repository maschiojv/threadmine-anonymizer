<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>dev.threadmine</groupId>
    <artifactId>tm-anon</artifactId>
    <version>0.2.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>tm-anon</name>
    <description>Local, offline anonymizer for JVM thread dumps. Zero network code by design.</description>
    <url>https://threadmine.dev</url>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
        </license>
    </licenses>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <junit.version>5.11.4</junit.version>
    </properties>

    <!--
      AUDIT NOTE: this project has ZERO runtime dependencies, on purpose.
      The only dependency below is test-scoped. NoNetworkArchitectureTest
      enforces that no HTTP/network dependency or java.net usage ever
      sneaks in.
    -->
    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!--
          The allowlist artifact lives at allowlist/allowlist-v1.json (single
          source of truth, reviewed in the open). It is copied into the jar
          root so AllowlistMatcher.fromClasspath() can load it offline.
        -->
        <resources>
            <resource>
                <directory>allowlist</directory>
                <includes>
                    <include>allowlist-v1.json</include>
                </includes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
                <configuration>
                    <!--
                      Windows loses a race deleting a @TempDir root: every child
                      is removed, then RemoveDirectory fails because the OS still
                      holds the directory handle for a moment. JUnit does not
                      retry, so it reports "Failed to close extension context"
                      and the build goes red with zero failed assertions. It hit
                      3-4 random classes per full run here and would do the same
                      on the windows-latest CI job.

                      Cleanup is therefore off, and the test JVM's temp root is
                      moved under target/ so `mvn clean` collects the leftovers
                      instead of them piling up in the user's TEMP. The contents
                      are throwaway fixtures and vaults with random test keys.
                    -->
                    <systemPropertyVariables>
                        <java.io.tmpdir>${project.build.directory}</java.io.tmpdir>
                        <junit.jupiter.tempdir.cleanup.mode.default>NEVER</junit.jupiter.tempdir.cleanup.mode.default>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>dev.threadmine.anon.cli.Main</mainClass>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
